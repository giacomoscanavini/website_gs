      "number": "1789",
      "group": "practice",
      "context": "My approach",
      "snippet": "def find_primary_department(employee: pd.DataFrame) -> pd.DataFrame:\n    employee['nDepartments'] =   employee.groupby('employee_id').department_id.transform('count')\n    employee =   employee.query(\"(primary_flag == 'Y')   | (nDepartments == 1)\")\n    return employee[['employee_id', 'department_id']]",
