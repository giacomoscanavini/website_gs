      "group": "practice",
      "context": "Study solution",
      "snippet": "def find_employees(employees: pd.DataFrame) -> pd.DataFrame:\n    mask = employees['salary'].lt(30000) & employees['manager_id'].notna() & ~employees['manager_id'].isin(employees['employee_id'])\n    return employees.loc[mask, ['employee_id']].sort_values('employee_id')",
      "snippetLine": 3
