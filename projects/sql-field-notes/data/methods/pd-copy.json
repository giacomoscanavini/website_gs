      "title": "610 · Triangle judgement",
      "number": "610",
      "group": "practice",
      "context": "Study solution",
      "snippet": "def triangle_judgement(triangle: pd.DataFrame) -> pd.DataFrame:\n    t = triangle.copy()\n    valid = (t['x'] + t['y'] > t['z']) & (t['x'] + t['z'] > t['y']) & (t['y'] + t['z'] > t['x'])\n    t['triangle'] = valid.map({True: 'Yes', False: 'No'})",
